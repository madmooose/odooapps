<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_order_batch_tree" model="ir.ui.view">
        <field name="name">sale.order.batch.tree</field>
        <field name="model">sale.order.batch</field>
        <field name="arch" type="xml">
            <tree>
                <field name="state"/>
                <field name="name"/>
                <field name="validity_date"/>
                <field name="sale_order_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="view_order_batch_form" model="ir.ui.view">
        <field name="name">sale.order.batch.form</field>
        <field name="model">sale.order.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': 'true'}"/>
                </header>
                <sheet>
                    <div name="button_box">
                        <button
                            class="oe_stat_button"
                            type="object"
                            name="action_view_source_sale_orders"
                            icon="fa-pencil-square-o"
                            attrs="{'invisible': [('sale_order_count', '=', 0)]}"
                        >
                            <field string="Sale Orders" name="sale_order_count" widget="statinfo"/>
                        </button>
                        <button
                            class="oe_stat_button"
                            type="object"
                            name="action_view_products"
                            icon="fa-cart-plus"
                            attrs="{'invisible': [('product_count', '=', 0)]}"
                        >
                            <field string="Products" name="product_count" widget="statinfo"/>
                        </button>
                    </div>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <group>
                        <group>
                            <field
                                name="sale_order_ids"
                                widget="many2many_tags"
                                domain="[('state','in',['draft','sent']),('batch_id','=',False)]"
                            />
                        </group>
                        <group>
                            <field name="validity_date"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

       <record id="sale_order_batch_view_search" model="ir.ui.view">
        <field name="name">sale.order.batch.view.search</field>
        <field name="model">sale.order.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter
                    string="Open"
                    name="filter_property_open"
                    domain="[('state', '=', 'open')
                    ]"
                />
            </search>
        </field>
    </record>

    <record id="action_batch" model="ir.actions.act_window">
        <field name="name">Sale Order Batches</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order.batch</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_filter_property_open': 1}</field>
    </record>

    <record id="action_open_orders" model="ir.actions.act_window">
        <field name="name">Action Open Orders</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('batch_id','=',self.acti)]</field>
        <field name="context">{'search_default_filter_property_open': 1}</field>
    </record>


</odoo>
